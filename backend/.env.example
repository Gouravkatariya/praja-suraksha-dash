# Copy this file to .env and fill in local credentials.
# Never commit real passwords.

# Option A — discrete connection fields (preferred)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=mplads_risk_db
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me

# Option B — full URL (overrides discrete fields if set)
# DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/mplads_risk_db

# Comma-separated browser origins for the React frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# FastAPI bind (used by README run command; not required by the app itself)
APP_HOST=127.0.0.1
APP_PORT=8000
